<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Uma Aventura de Amor para Dayane ❤️</title>
    
    <!-- Tailwind CSS CDN para estruturação responsiva ágil -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Press Start 2P & VT323 (Pixel/Minecraft) + Lora & Caveat (Carta Romântica) -->
    <!-- Com fallbacks seguros locais caso offline -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">

    <!-- Three.js + GLTFLoader + GSAP para animações cinematográficas -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

    <style>
        /* ==========================================================================
           1. IDENTIDADE VISUAL E PALETA OFICIAL OBRIGATÓRIA
           ========================================================================== */
        :root {
            --color-yellow: #FFD13B;      /* Amarelo luminoso */
            --color-pink: #FFA9B6;        /* Rosa-pêssego suave */
            --color-orange: #E87A5D;      /* Laranja quente */
            --color-green: #4B7931;       /* Verde-floresta */
            --color-red: #E02424;         /* Vermelho-coração */
            --color-graphite: #222222;    /* Preto-grafite */
            
            /* Cores de papel claro para leitura confortável com alto contraste */
            --paper-cream: #FFF9EE;
            --paper-pink-soft: #FFF1F4;
            --paper-border: #E2C6A8;
            --book-leather: #58131D;
            --book-leather-dark: #3B0B12;

            /* Tipografia com fallbacks locais seguros */
            --font-pixel-title: 'Press Start 2P', 'Courier New', monospace;
            --font-pixel-ui: 'VT323', 'Lucida Console', monospace;
            --font-diary: 'Lora', 'Georgia', serif;
            --font-handwriting: 'Caveat', 'Comic Sans MS', cursive;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: linear-gradient(180deg, #E87A5D 0%, #FFA9B6 48%, #FFD13B 100%);
            font-family: var(--font-diary);
            color: var(--color-graphite);
        }

        /* Canvas 3D ocupando a tela inteira */
        #webgl-container {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            transition: filter 0.8s ease;
        }

        #webgl-container.book-focus {
            filter: brightness(0.86) saturate(1.08);
        }

        /* ==========================================================================
           ESTÉTICA DE INTERFACE MINECRAFT / VOXEL ROMÂNTICO
           ========================================================================== */
        .font-pixel {
            font-family: var(--font-pixel-title);
            line-height: 1.45;
        }

        .font-pixel-lg {
            font-family: var(--font-pixel-ui);
            letter-spacing: 0.04em;
        }

        .font-diary {
            font-family: var(--font-diary);
            user-select: text;
        }

        .font-hand {
            font-family: var(--font-handwriting);
        }

        /* Painel estilo bloco de madeira/pergaminho com borda voxel */
        .voxel-card {
            background: rgba(255, 249, 238, 0.94);
            border: 4px solid var(--color-graphite);
            box-shadow: 
                inset 0 0 0 4px var(--color-pink),
                0 10px 0 rgba(34, 34, 34, 0.35),
                0 16px 32px rgba(34, 34, 34, 0.25);
            border-radius: 6px;
            position: relative;
        }

        /* Botão Principal estilo Minecraft Interativo */
        .mc-btn {
            font-family: var(--font-pixel-title);
            background: linear-gradient(180deg, var(--color-yellow) 0%, #F4B41A 100%);
            color: var(--color-graphite);
            border: 4px solid var(--color-graphite);
            box-shadow: 
                inset -4px -4px 0px #C88412,
                inset 4px 4px 0px #FFF1AA,
                0 6px 0 var(--color-graphite),
                0 10px 20px rgba(34, 34, 34, 0.35);
            padding: 1rem 1.4rem;
            border-radius: 6px;
            cursor: pointer;
            transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.2s ease;
            position: relative;
            text-align: center;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }

        .mc-btn:hover:not(:disabled) {
            background: linear-gradient(180deg, #FFE066 0%, var(--color-yellow) 100%);
            transform: translateY(-2px);
            box-shadow: 
                inset -4px -4px 0px #D48E15,
                inset 4px 4px 0px #FFF7CC,
                0 8px 0 var(--color-graphite),
                0 14px 24px rgba(224, 36, 36, 0.3);
        }

        .mc-btn:active:not(:disabled),
        .mc-btn.pressed {
            transform: translateY(4px);
            box-shadow: 
                inset 3px 3px 0px #C88412,
                0 2px 0 var(--color-graphite);
        }

        .mc-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        .mc-btn-red {
            background: linear-gradient(180deg, #F23838 0%, var(--color-red) 100%);
            color: #FFFFFF;
            box-shadow: 
                inset -4px -4px 0px #9E1414,
                inset 4px 4px 0px #FF8A8A,
                0 6px 0 var(--color-graphite),
                0 10px 20px rgba(34, 34, 34, 0.35);
        }

        .mc-btn-red:hover:not(:disabled) {
            background: linear-gradient(180deg, #FF5252 0%, #E02424 100%);
            box-shadow: 
                inset -4px -4px 0px #9E1414,
                inset 4px 4px 0px #FF9E9E,
                0 8px 0 var(--color-graphite),
                0 14px 24px rgba(224, 36, 36, 0.45);
        }

        .mc-btn-secondary {
            font-family: var(--font-pixel-ui);
            font-size: 1.35rem;
            background: var(--paper-cream);
            color: var(--color-graphite);
            border: 3px solid var(--color-graphite);
            box-shadow: 
                inset -3px -3px 0px #D8C3A5,
                inset 3px 3px 0px #FFFFFF,
                0 4px 0 var(--color-graphite);
            padding: 0.45rem 1rem;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.12s ease;
        }

        .mc-btn-secondary:hover:not(:disabled) {
            background: var(--color-yellow);
            transform: translateY(-2px);
            box-shadow: 
                inset -3px -3px 0px #C88412,
                inset 3px 3px 0px #FFF4B8,
                0 6px 0 var(--color-graphite);
        }

        .mc-btn-secondary:active:not(:disabled) {
            transform: translateY(2px);
            box-shadow: 0 2px 0 var(--color-graphite);
        }

        /* ==========================================================================
           LIVRO TRIDIMENSIONAL INTERATIVO E ANIMAÇÃO DE VIRAR PÁGINA (CSS 3D)
           ========================================================================== */
        .book-perspective-stage {
            perspective: 1800px;
        }

        .book-shell {
            background: linear-gradient(135deg, var(--book-leather) 0%, var(--book-leather-dark) 100%);
            border: 4px solid var(--color-graphite);
            border-radius: 10px;
            padding: 12px;
            box-shadow: 
                0 20px 50px rgba(34, 34, 34, 0.55),
                0 0 0 4px var(--color-yellow),
                0 0 30px rgba(255, 209, 59, 0.35);
            position: relative;
            transform-style: preserve-3d;
        }

        /* Cantoneiras douradas em pixel art no livro */
        .book-corner {
            position: absolute;
            width: 22px;
            height: 22px;
            background: var(--color-yellow);
            border: 3px solid var(--color-graphite);
            z-index: 20;
            pointer-events: none;
        }
        .book-corner.tl { top: -4px; left: -4px; border-bottom-right-radius: 6px; }
        .book-corner.tr { top: -4px; right: -4px; border-bottom-left-radius: 6px; }
        .book-corner.bl { bottom: -4px; left: -4px; border-top-right-radius: 6px; }
        .book-corner.br { bottom: -4px; right: -4px; border-top-left-radius: 6px; }

        /* Folha de papel creme com bordas suaves e textura de diário */
        .book-page-sheet {
            background: 
                radial-gradient(circle at top right, var(--paper-pink-soft), transparent 65%),
                linear-gradient(90deg, #EADAC3 0%, var(--paper-cream) 6%, var(--paper-cream) 94%, #EFE1CE 100%);
            border: 3px solid var(--color-graphite);
            border-radius: 6px;
            position: relative;
            overflow: hidden;
            box-shadow: 
                inset 0 0 24px rgba(232, 122, 93, 0.12),
                4px 4px 0 #D5BFA3,
                8px 8px 0 #BDA384;
            transform-origin: left center;
            transform-style: preserve-3d;
            backface-visibility: hidden;
        }

        /* Sombra dinâmica durante o giro 3D da folha */
        .page-curl-shadow {
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(90deg, rgba(34,34,34,0.22) 0%, transparent 25%, transparent 75%, rgba(34,34,34,0.18) 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 15;
        }

        /* Animações de virar página para frente e para trás */
        @keyframes flipPageNext {
            0% {
                transform: rotateY(0deg) scale(1);
                filter: brightness(1);
            }
            45% {
                transform: rotateY(-88deg) skewY(3deg) scale(0.98);
                filter: brightness(0.82);
            }
            55% {
                transform: rotateY(80deg) skewY(-3deg) scale(0.98);
                filter: brightness(0.88);
            }
            100% {
                transform: rotateY(0deg) scale(1);
                filter: brightness(1);
            }
        }

        @keyframes flipPagePrev {
            0% {
                transform: rotateY(0deg) scale(1);
                filter: brightness(1);
            }
            45% {
                transform: rotateY(85deg) skewY(-3deg) scale(0.98);
                filter: brightness(0.82);
            }
            55% {
                transform: rotateY(-85deg) skewY(3deg) scale(0.98);
                filter: brightness(0.88);
            }
            100% {
                transform: rotateY(0deg) scale(1);
                filter: brightness(1);
            }
        }

        .turning-next {
            animation: flipPageNext 0.68s cubic-bezier(0.45, 0.05, 0.55, 0.95) forwards;
        }

        .turning-prev {
            animation: flipPagePrev 0.68s cubic-bezier(0.45, 0.05, 0.55, 0.95) forwards;
        }

        /* Áreas clicáveis nas laterais da folha para virar página */
        .page-edge-hotspot {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 44px;
            z-index: 12;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.2s ease, background 0.2s ease;
        }
        .page-edge-hotspot:hover {
            opacity: 1;
            background: rgba(255, 209, 59, 0.18);
        }
        .page-edge-left { left: 0; border-right: 1px dashed rgba(232, 122, 93, 0.35); }
        .page-edge-right { right: 0; border-left: 1px dashed rgba(232, 122, 93, 0.35); }

        /* Scrollbar discreta e elegante para páginas em telas menores */
        .diary-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .diary-scroll::-webkit-scrollbar-track {
            background: rgba(255, 169, 182, 0.2);
            border-radius: 4px;
        }
        .diary-scroll::-webkit-scrollbar-thumb {
            background: var(--color-orange);
            border-radius: 4px;
        }

        /* Animação pulsante para indicadores e corações */
        @keyframes floatPulse {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-5px) scale(1.06); }
        }
        .animate-float {
            animation: floatPulse 2.6s ease-in-out infinite;
        }

        @keyframes arrowBounceRight {
            0%, 100% { transform: translateX(0); }
            50% { transform: translateX(7px); }
        }
        .arrow-bounce {
            animation: arrowBounceRight 1s ease-in-out infinite;
        }

        /* Destaque especial para a palavra ABRAÇO na cena final */
        .hug-highlight {
            display: inline-block;
            background: var(--color-yellow);
            color: var(--color-graphite);
            padding: 0.15rem 0.65rem;
            border: 3px solid var(--color-graphite);
            border-radius: 6px;
            box-shadow: 0 4px 0 var(--color-red);
            transform: rotate(-1.5deg);
        }

        /* Respeito à preferência de movimento reduzido do sistema */
        @media (prefers-reduced-motion: reduce) {
            .turning-next, .turning-prev, .animate-float, .arrow-bounce {
                animation: none !important;
            }
        }
    </style>
</head>
<body class="relative select-none overflow-hidden">

    <!-- ==========================================================================
         CANVAS 3D (THREE.JS: MUNDO MINECRAFT PÔR DO SOL + PERSONAGEM + LIVRO 3D)
         ========================================================================== -->
    <div id="webgl-container" aria-hidden="true"></div>

    <!-- ==========================================================================
         BARRA SUPERIOR FIXA (CONTROLE DE ÁUDIO, INDICADOR DE CENA E UPLOAD GLB)
         ========================================================================== -->
    <header class="fixed top-0 left-0 right-0 z-30 flex items-center justify-between px-3 py-2.5 sm:px-6 sm:py-3 pointer-events-none">
        <!-- Badge Romântico "Eu ❤️ Day" inspirado na referência do casal -->
        <div class="pointer-events-auto flex items-center gap-2 bg-[#FFF9EE]/95 border-2 border-[#222222] px-3 py-1.5 rounded-md shadow-md">
            <span class="inline-block w-3 h-3 bg-[#E02424] border border-[#222222]" title="Coração Voxel"></span>
            <span class="font-pixel text-[10px] sm:text-xs text-[#222222] tracking-tight">
                EU <span class="text-[#E02424]">❤️</span> DAY
            </span>
            <span id="model-status-badge" class="hidden md:inline-block ml-1 text-[11px] font-pixel-lg bg-[#FFD13B] text-[#222222] px-2 py-0.5 rounded border border-[#222222]">
                Mascote 3D Ativo
            </span>
        </div>

        <!-- Controles de Som, Câmera e Arquivo GLB -->
        <div class="pointer-events-auto flex items-center gap-2">
            <!-- Botão de Áudio Ambiente Romântico (Web Audio API) -->
            <button id="btn-audio-toggle" type="button" class="mc-btn-secondary text-sm sm:text-base flex items-center gap-1.5 py-1 px-3" aria-label="Alternar som ambiente">
                <span id="audio-icon">🔇</span>
                <span id="audio-label" class="hidden sm:inline">Som: Off</span>
            </button>

            <!-- Botão de Reiniciar Jornada (visível após avançar da cena 1) -->
            <button id="btn-reset-journey" type="button" class="hidden mc-btn-secondary text-sm sm:text-base py-1 px-2.5" title="Voltar ao início">
                ↺ Início
            </button>
        </div>
    </header>

    <!-- ==========================================================================
         CENA 1 — ENTRANDO NO MEU MUNDO (PÁGINA INICIAL)
         ========================================================================== -->
    <main id="scene-1-ui" class="fixed inset-0 z-20 flex flex-col justify-end md:justify-center items-center md:items-end p-4 sm:p-8 lg:pr-16 pointer-events-none transition-opacity duration-500">
        
        <div class="voxel-card max-w-lg w-full p-5 sm:p-7 pointer-events-auto mb-2 md:mb-0">
            <!-- Cabeçalho decorativo pixel art -->
            <div class="flex items-center justify-between border-b-2 border-[#E87A5D]/40 pb-2.5 mb-4">
                <div class="flex items-center gap-2">
                    <span class="text-[#E02424] text-lg">❤️</span>
                    <span class="font-pixel text-[10px] sm:text-xs uppercase tracking-wider text-[#4B7931]">
                        Mundo de Blocos • Pôr do Sol
                    </span>
                </div>
                <span class="font-pixel-lg text-lg text-[#E87A5D]">Para: Dayane</span>
            </div>

            <!-- Citação Inicial Exata Obrigatória -->
            <blockquote class="font-diary text-[#222222] text-base sm:text-xl leading-relaxed font-semibold mb-6 bg-[#FFF1F4]/80 p-3.5 sm:p-4 rounded border-l-4 border-[#E02424]">
                “Em todas as aventuras que escolhi no meu mundo de blocos, a de te escolher como minha companheira foi definitivamente a melhor.”
            </blockquote>

            <!-- Indicador de interação com o personagem -->
            <div class="flex items-center gap-2 mb-3 text-xs sm:text-sm text-[#222222]/80 font-diary italic">
                <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#4B7931] animate-ping"></span>
                <span>Dica: Passe o cursor no botão ou arraste o cenário 3D para olhar ao redor!</span>
            </div>

            <!-- Botão Principal Exato Obrigatório -->
            <button id="btn-enter-world" type="button" class="mc-btn w-full text-xs sm:text-sm leading-snug">
                <span class="arrow-bounce text-[#E02424] text-base sm:text-lg">➤</span>
                <span>Clique para entender todo meu amor por você</span>
            </button>
        </div>
    </main>

    <!-- ==========================================================================
         CENA 2A — O LIVRO FECHADO NAS MÃOS DO PERSONAGEM
         ========================================================================== -->
    <section id="scene-2-closed-ui" class="fixed inset-0 z-20 hidden opacity-0 flex-col justify-end items-center p-5 sm:p-10 pointer-events-none transition-opacity duration-500">
        <div class="voxel-card max-w-md w-full p-5 sm:p-6 text-center pointer-events-auto mb-2 sm:mb-4">
            <div class="inline-flex items-center gap-2 bg-[#FFD13B] border-2 border-[#222222] px-3 py-1 rounded text-xs font-pixel text-[#222222] mb-3">
                <span>📖</span>
                <span>ITEM ESPECIAL ENCONTRADO</span>
            </div>
            <p class="font-diary text-[#222222] text-sm sm:text-base mb-4 leading-relaxed">
                Guardei cada pensamento, cada viagem e cada detalhe da nossa história dentro deste livro.
            </p>
            <!-- Botão Exato do Livro -->
            <button id="btn-open-book" type="button" class="mc-btn mc-btn-red w-full text-xs sm:text-sm">
                <span>✨</span>
                <span>Clique aqui para amar mais</span>
                <span class="arrow-bounce">❤️</span>
            </button>
        </div>
    </section>

    <!-- ==========================================================================
         CENA 2B — O LIVRO ABERTO INTERATIVO (8 PÁGINAS DA DECLARAÇÃO)
         ========================================================================== -->
    <section id="scene-2-open-ui" class="fixed inset-0 z-20 hidden opacity-0 flex-col justify-between lg:justify-center items-center lg:items-end p-2.5 sm:p-6 lg:pr-12 pt-14 pb-3 pointer-events-none transition-opacity duration-500">
        
        <div class="book-perspective-stage w-full max-w-xl pointer-events-auto flex flex-col">
            <!-- Moldura de Couro e Ouro do Livro -->
            <div class="book-shell w-full">
                <!-- Cantoneiras Douradas #FFD13B -->
                <div class="book-corner tl"></div>
                <div class="book-corner tr"></div>
                <div class="book-corner bl"></div>
                <div class="book-corner br"></div>

                <!-- Folha Principal do Livro com suporte a Giro 3D -->
                <article id="book-page-sheet" class="book-page-sheet w-full p-4 sm:p-7 md:p-8 flex flex-col justify-between min-h-[370px] sm:min-h-[430px] max-h-[75vh]">
                    <div id="page-curl-shadow" class="page-curl-shadow"></div>

                    <!-- Hotspots laterais para clicar nas bordas do livro -->
                    <div id="hotspot-prev-page" class="page-edge-hotspot page-edge-left" title="Página anterior">
                        <span class="font-pixel text-[#222222] bg-[#FFD13B] border-2 border-[#222222] px-1.5 py-1 rounded text-xs">◀</span>
                    </div>
                    <div id="hotspot-next-page" class="page-edge-hotspot page-edge-right" title="Próxima página">
                        <span class="font-pixel text-[#222222] bg-[#FFD13B] border-2 border-[#222222] px-1.5 py-1 rounded text-xs">▶</span>
                    </div>

                    <!-- Topo da Página: Numeração e Detalhes Voxel -->
                    <div>
                        <div class="flex items-center justify-between border-b-2 border-[#E87A5D]/50 pb-2 mb-3">
                            <span id="page-badge-number" class="font-pixel text-[10px] sm:text-xs bg-[#FFD13B] text-[#222222] border-2 border-[#222222] px-2.5 py-1 rounded">
                                01/08
                            </span>
                            <div id="page-decorative-icons" class="flex items-center gap-1.5 text-sm sm:text-base">
                                <span>❤️</span><span>✨</span><span>🌸</span>
                            </div>
                        </div>

                        <!-- Título da Página -->
                        <h2 id="page-title" class="font-pixel text-xs sm:text-sm md:text-base text-[#E02424] mb-3 leading-snug">
                            Página 01 — Como começar
                        </h2>
                    </div>

                    <!-- Corpo do Texto da Declaração (Scroll discreto se necessário em telas pequenas) -->
                    <div id="page-content-scroll" class="diary-scroll overflow-y-auto pr-1 my-auto py-2">
                        <p id="page-text" class="font-diary text-[#222222] text-base sm:text-lg md:text-[19px] leading-relaxed whitespace-pre-line">
                            <!-- Preenchido dinamicamente pelo array de dados oficial -->
                        </p>
                    </div>

                    <!-- Rodapé da Folha: Assinatura / Nota sutil e Barra de Progresso -->
                    <div class="mt-4 pt-3 border-t-2 border-[#FFA9B6]/60 flex flex-col gap-2">
                        <div class="flex items-center justify-between text-xs sm:text-sm">
                            <span id="page-footer-note" class="font-hand text-lg sm:text-xl text-[#4B7931] font-bold">
                                Para minha futura noiva Dayane ❤️
                            </span>
                            <span id="page-progress-label" class="font-pixel-lg text-base sm:text-lg text-[#222222]">
                                Página 01 de 08
                            </span>
                        </div>
                        <!-- Barra de progresso em blocos -->
                        <div id="page-progress-blocks" class="grid grid-cols-8 gap-1 w-full h-2.5">
                            <!-- 8 blocos gerados via JS -->
                        </div>
                    </div>
                </article>

                <!-- Controles de Navegação do Livro (Anterior / Próxima / Encerramento na pág 08) -->
                <div class="mt-3 flex items-center justify-between gap-2 px-1">
                    <button id="btn-prev-page" type="button" class="mc-btn-secondary flex items-center gap-1.5 text-base sm:text-lg">
                        <span>◀</span>
                        <span>Anterior</span>
                    </button>

                    <span class="hidden sm:inline-block font-pixel-lg text-[#FFF9EE] text-base tracking-wide">
                        Use as setas ou clique nas bordas
                    </span>

                    <button id="btn-next-page" type="button" class="mc-btn py-2 px-4 text-[11px] sm:text-xs">
                        <span id="btn-next-page-text">Próxima Página</span>
                        <span>▶</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================================================

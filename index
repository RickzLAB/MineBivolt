            buildVoxelEnvironment() {
                this.envGroup = new THREE.Group();
                this.scene.add(this.envGroup);

                const boxGeo = new THREE.BoxGeometry(1, 1, 1);

                // Materiais Voxel na paleta oficial
                const grassMat = new THREE.MeshStandardMaterial({ color: 0x4B7931, roughness: 0.85 });
                const grassLightMat = new THREE.MeshStandardMaterial({ color: 0x5B8E3D, roughness: 0.85 });
                const dirtMat = new THREE.MeshStandardMaterial({ color: 0x6E472B, roughness: 0.9 });
                const trunkMat = new THREE.MeshStandardMaterial({ color: 0x54361E, roughness: 0.9 });
                const cherryLeavesMat = new THREE.MeshStandardMaterial({ color: 0xFFA9B6, roughness: 0.7 });
                const yellowFlowerMat = new THREE.MeshStandardMaterial({ color: 0xFFD13B, roughness: 0.5 });
                const redHeartFlowerMat = new THREE.MeshStandardMaterial({ color: 0xE02424, roughness: 0.5 });
                const waterMat = new THREE.MeshStandardMaterial({
                    color: 0x4FA4E8,
                    roughness: 0.2,
                    metalness: 0.1,
                    transparent: true,
                    opacity: 0.82
                });

                // 1. Terreno em blocos verdes (#4B7931)
                for (let x = -8; x <= 8; x++) {
                    for (let z = -8; z <= 5; z++) {
                        const dist = Math.sqrt(x * x + z * z);
                        if (dist > 9.5) continue;

                        // Pequenas colinas nas bordas traseiras
                        let height = 0;
                        if (z < -2 && Math.abs(x) > 2) height = 1;
                        if (z < -4 && Math.abs(x) > 3) height = 2;

                        for (let y = -1; y <= height; y++) {
                            const isTop = (y === height);
                            // Pequeno riacho à direita como na imagem de referência
                            const isWater = (x >= 3 && x <= 4 && z >= -3 && z <= 2 && height === 0);

                            const mat = isWater
                                ? waterMat
                                : (isTop ? ((x + z) % 2 === 0 ? grassMat : grassLightMat) : dirtMat);

                            const block = new THREE.Mesh(boxGeo, mat);
                            block.position.set(x, y - 0.5, z);
                            block.receiveShadow = true;
                            if (y > 0) block.castShadow = true;
                            this.envGroup.add(block);

                            // Flores em voxel espalhadas pelo jardim
                            if (isTop && !isWater && dist > 1.8 && Math.random() < 0.16) {
                                const stem = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.25, 0.08), grassMat);
                                stem.position.set(x + (Math.random() - 0.5) * 0.4, y + 0.12, z + (Math.random() - 0.5) * 0.4);
                                const petalMat = Math.random() > 0.45 ? yellowFlowerMat : redHeartFlowerMat;
                                const petal = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.18, 0.22), petalMat);
                                petal.position.y = 0.15;
                                stem.add(petal);
                                this.envGroup.add(stem);
                            }
                        }
                    }
                }

                // 2. Árvores Voxel (Carvalho Verde #4B7931 e Cerejeiras Rosa #FFA9B6 da foto Eu & Day)
                const createVoxelTree = (tx, ty, tz, leavesMaterial, hasLantern = false) => {
                    const tree = new THREE.Group();
                    tree.position.set(tx, ty, tz);

                    // Tronco de 3 blocos
                    for (let i = 0; i < 3; i++) {
                        const trunk = new THREE.Mesh(boxGeo, trunkMat);
                        trunk.position.set(0, i + 0.5, 0);
                        trunk.castShadow = true;
                        trunk.receiveShadow = true;
                        tree.add(trunk);
                    }

                    // Copa em blocos
                    for (let lx = -1; lx <= 1; lx++) {
                        for (let lz = -1; lz <= 1; lz++) {
                            for (let ly = 3; ly <= 4; ly++) {
                                if (ly === 4 && Math.abs(lx) === 1 && Math.abs(lz) === 1) continue;
                                const leaf = new THREE.Mesh(boxGeo, leavesMaterial);
                                leaf.position.set(lx, ly + 0.4, lz);
                                leaf.castShadow = true;
                                tree.add(leaf);
                            }
                        }
                    }

                    // Lanterna suspensa brilhante (#FFD13B + #E87A5D) igual à referência
                    if (hasLantern) {
                        const chain = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.4, 0.08), new THREE.MeshStandardMaterial({ color: 0x222222 }));
                        chain.position.set(1, 2.8, 0.8);
                        const lanternGlow = new THREE.Mesh(
                            new THREE.BoxGeometry(0.36, 0.44, 0.36),
                            new THREE.MeshBasicMaterial({ color: 0xFFD13B })
                        );
                        lanternGlow.position.y = -0.35;
                        const lanternFrame = new THREE.Mesh(
                            new THREE.BoxGeometry(0.42, 0.08, 0.42),
                            new THREE.MeshStandardMaterial({ color: 0xE87A5D })
                        );
                        lanternFrame.position.y = 0.22;
                        lanternGlow.add(lanternFrame);
                        chain.add(lanternGlow);
                        tree.add(chain);
                    }

                    this.envGroup.add(tree);
                };

                createVoxelTree(-3.8, 0, -2.5, grassMat, true);
                createVoxelTree(-5.2, 1, -5.2, cherryLeavesMat, false);
                createVoxelTree(4.6, 1, -4.2, cherryLeavesMat, true);
                createVoxelTree(2.2, 1, -6.0, grassLightMat, false);
                createVoxelTree(-1.8, 1, -6.2, cherryLeavesMat, false);

                // Pets fofos da imagem de referência (Cachorrinho branco com coleira vermelha e Porquinho rosa à esquerda)
                this.buildCompanionPets();

                // 3. Sol Cúbico Dourado Estilo Minecraft no Horizonte (#FFD13B)
                const sunGroup = new THREE.Group();
                sunGroup.position.set(4.5, 5.2, -14);
                const sunCore = new THREE.Mesh(
                    new THREE.BoxGeometry(2.6, 2.6, 0.4),
                    new THREE.MeshBasicMaterial({ color: 0xFFD13B })
                );
                const sunHalo = new THREE.Mesh(
                    new THREE.BoxGeometry(3.5, 3.5, 0.2),
                    new THREE.MeshBasicMaterial({ color: 0xFFA9B6, transparent: true, opacity: 0.45 })
                );
                sunHalo.position.z = -0.2;
                sunGroup.add(sunCore, sunHalo);
                this.scene.add(sunGroup);
                this.sunGroup = sunGroup;

                // 4. Nuvens em Blocos Rosa-Pêssego (#FFA9B6) e Creme
                const cloudMat = new THREE.MeshBasicMaterial({ color: 0xFFF0F3, transparent: true, opacity: 0.82 });
                for (let i = 0; i < 6; i++) {
                    const cloud = new THREE.Mesh(
                        new THREE.BoxGeometry(2.4 + Math.random() * 1.8, 0.45, 1.2),
                        cloudMat
                    );
                    cloud.position.set((i - 2.5) * 4.2, 5.8 + (i % 2) * 0.9, -10 - (i % 3) * 2);
                    this.scene.add(cloud);
                    this.clouds.push(cloud);
                }

                // 5. Partículas Luminosas Douradas (#FFD13B)
                const particleCount = 65;
                const positions = new Float32Array(particleCount * 3);
                for (let i = 0; i < particleCount; i++) {
                    positions[i * 3] = (Math.random() - 0.5) * 14;
                    positions[i * 3 + 1] = Math.random() * 5 + 0.3;
                    positions[i * 3 + 2] = (Math.random() - 0.5) * 10;
                }
                const particleGeo = new THREE.BufferGeometry();
                particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
                const particleMat = new THREE.PointsMaterial({
                    color: 0xFFD13B,
                    size: 0.14,
                    transparent: true,
                    opacity: 0.85
                });
                this.goldenParticles = new THREE.Points(particleGeo, particleMat);
                this.scene.add(this.goldenParticles);

                // 6. Corações Voxel 3D Flutuantes (#E02424)
                for (let i = 0; i < 12; i++) {
                    const heart = this.createVoxelHeartMesh(0.08);
                    heart.position.set(
                        (Math.random() - 0.5) * 6,
                        0.6 + Math.random() * 3.2,
                        (Math.random() - 0.5) * 4
                    );
                    heart.userData = {
                        baseY: heart.position.y,
                        speed: 1.2 + Math.random() * 1.5,
                        phase: Math.random() * Math.PI * 2
                    };
                    this.scene.add(heart);
                    this.floatingHearts.push(heart);
                }
            }


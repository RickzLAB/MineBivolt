        /**
         * ============================================================================
         * MÓDULO 2: GERADOR DE TEXTURAS PIXEL ART E PERSONAGEM FIEL ÀS IMAGENS
         * Constrói o personagem exatamente como nas imagens enviadas:
         * - Cabelo cacheado/texturizado em múltiplos blocos 3D com volume
         * - Rosto com sobrancelhas, olhos detalhados, blush suave, sorriso e óculos vazados
         * - Camiseta preta com mangas curtas, emblema vermelho pixelado e corrente prateada
         * - Braços em tom de pele com mangas pretas nos ombros e relógio metálico detalhado
         * - Calça cargo escura quadriculada em pixel art e tênis preto/cinza com sola branca
         * ============================================================================
         */
        class VoxelTextureFactory {
            static createPixelCanvasTexture(width, height, drawFn) {
                const canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.imageSmoothingEnabled = false;
                drawFn(ctx, width, height);
                const texture = new THREE.CanvasTexture(canvas);
                texture.magFilter = THREE.NearestFilter;
                texture.minFilter = THREE.NearestFilter;
                texture.encoding = THREE.sRGBEncoding;
                return texture;
            }

            // Textura da frente da camiseta preta com o símbolo vermelho idêntico à imagem e colar prateado
            static createShirtFrontTexture() {
                return this.createPixelCanvasTexture(32, 36, (ctx, w, h) => {
                    // Fundo preto/grafite com micro-variação de tecido pixel art
                    const baseColors = ['#141418', '#18181D', '#121216', '#1B1B21'];
                    for (let y = 0; y < h; y++) {
                        for (let x = 0; x < w; x++) {
                            ctx.fillStyle = baseColors[(x * 3 + y * 5) % baseColors.length];
                            ctx.fillRect(x, y, 1, 1);
                        }
                    }

                    // Gola escura
                    ctx.fillStyle = '#0D0D10';
                    ctx.fillRect(10, 0, 12, 3);
                    ctx.fillRect(12, 3, 8, 2);

                    // Emblema vermelho em pixel art (losango/diamante cortado por haste vertical igual à imagem)
                    const emblemPixels = [
                        "       ..       ",
                        "      .XX.      ",
                        "      .XX.      ",
                        "     ..XX..     ",
                        "    .XXXXXX.    ",
                        "   .XXXXXXXX.   ",
                        "  .XXX.XX.XXX.  ",
                        " .XXX..XX..XXX. ",
                        " .XX...XX...XX. ",
                        "  .XXX.XX.XXX.  ",
                        "   .XXXXXXXX.   ",
                        "    .XXXXXX.    ",
                        "     ..XX..     ",
                        "      .XX.      ",
                        "      .XX.      ",
                        "      .XX.      ",
                        "       ..       "
                    ];
                    const startX = 8;
                    const startY = 12;
                    for (let r = 0; r < emblemPixels.length; r++) {
                        for (let c = 0; c < emblemPixels[r].length; c++) {
                            const ch = emblemPixels[r][c];
                            if (ch === 'X') {
                                ctx.fillStyle = (r + c) % 2 === 0 ? '#C81E32' : '#A61728';
                                ctx.fillRect(startX + c, startY + r, 1, 1);
                            } else if (ch === '.') {
                                ctx.fillStyle = '#6E101C';
                                ctx.fillRect(startX + c, startY + r, 1, 1);
                            }
                        }
                    }
                });
            }

            // Textura geral do tecido preto (costas e mangas)
            static createBlackFabricTexture() {
                return this.createPixelCanvasTexture(16, 16, (ctx, w, h) => {
                    const cols = ['#141418', '#18181D', '#121216', '#1A1A20'];
                    for (let y = 0; y < h; y++) {
                        for (let x = 0; x < w; x++) {
                            ctx.fillStyle = cols[(x + y * 2) % cols.length];
                            ctx.fillRect(x, y, 1, 1);
                        }
                    }
                });
            }

            // Textura da calça cargo xadrez/pixelada escura idêntica às imagens
            static createCargoPantsTexture() {
                return this.createPixelCanvasTexture(16, 24, (ctx, w, h) => {
                    const palette = ['#211F26', '#2A2731', '#1B1920', '#322E3A', '#25232B'];
                    for (let y = 0; y < h; y++) {
                        for (let x = 0; x < w; x++) {
                            const blockX = Math.floor(x / 2);
                            const blockY = Math.floor(y / 2);
                            ctx.fillStyle = palette[(blockX * 3 + blockY * 7) % palette.length];
                            ctx.fillRect(x, y, 1, 1);
                        }
                    }
                    // Detalhe de costura/bolso lateral cargo
                    ctx.fillStyle = '#16141A';
                    ctx.fillRect(1, 8, 14, 1);
                    ctx.fillRect(2, 14, 12, 1);
                });
            }

            // Textura de pele quente bronzeada com sombreamento suave voxel
            static createSkinTexture() {
                return this.createPixelCanvasTexture(16, 16, (ctx, w, h) => {
                    const skinTones = ['#DC8B53', '#E2925A', '#D6834B', '#E69962'];
                    for (let y = 0; y < h; y++) {
                        for (let x = 0; x < w; x++) {
                            ctx.fillStyle = skinTones[(x * 2 + y * 3) % skinTones.length];
                            ctx.fillRect(x, y, 1, 1);
                        }
                    }
                });
            }

            // Textura do rosto fiel à prancha (sobrancelhas expressivas, olhos grandes castanho-escuros, brilho, blush e sorriso)
            static createFaceTexture() {
                return this.createPixelCanvasTexture(32, 32, (ctx, w, h) => {
                    // Base de pele iluminada estilo render Minecraft
                    for (let y = 0; y < h; y++) {
                        for (let x = 0; x < w; x++) {
                            let color = '#E08E55';
                            if (y < 8) color = '#D27D45'; // Sombra suave da testa junto à franja
                            else if (y > 24) color = '#D7834B';
                            else if (x > 10 && x < 22 && y >= 8 && y <= 22) color = '#EA9B64'; // Iluminação central do rosto
                            ctx.fillStyle = color;
                            ctx.fillRect(x, y, 1, 1);
                        }
                    }

                    // Sobrancelhas grossas castanho-escuras (levemente arqueadas e simpáticas)
                    ctx.fillStyle = '#23140D';
                    ctx.fillRect(5, 9, 8, 2);
                    ctx.fillRect(4, 10, 2, 1);
                    ctx.fillRect(19, 9, 8, 2);
                    ctx.fillRect(26, 10, 2, 1);

                    // Olhos (Esclera branca + Íris castanho-escura/violeta escuro + Brilho branco)
                    // Olho esquerdo
                    ctx.fillStyle = '#FAF3E8';
                    ctx.fillRect(5, 13, 8, 5);
                    ctx.fillStyle = '#25181E';
                    ctx.fillRect(8, 13, 4, 5);
                    ctx.fillStyle = '#120B0E';
                    ctx.fillRect(9, 14, 2, 4);
                    ctx.fillStyle = '#FFFFFF'; // Brilho vivo no olho
                    ctx.fillRect(8, 13, 2, 2);

                    // Olho direito
                    ctx.fillStyle = '#FAF3E8';
                    ctx.fillRect(19, 13, 8, 5);
                    ctx.fillStyle = '#25181E';
                    ctx.fillRect(20, 13, 4, 5);
                    ctx.fillStyle = '#120B0E';
                    ctx.fillRect(21, 14, 2, 4);
                    ctx.fillStyle = '#FFFFFF'; // Brilho vivo no olho
                    ctx.fillRect(20, 13, 2, 2);

                    // Blush avermelhado/alaranjado suave nas bochechas (igual às imagens)
                    ctx.fillStyle = '#D96B43';
                    ctx.fillRect(4, 19, 4, 2);
                    ctx.fillRect(24, 19, 4, 2);

                    // Nariz sutil em relevo de cor
                    ctx.fillStyle = '#C9723D';
                    ctx.fillRect(15, 17, 2, 3);

                    // Sorriso confiante e carinhoso (levemente inclinado nos cantos como na prancha)
                    ctx.fillStyle = '#3A1D12';
                    ctx.fillRect(11, 23, 10, 1);
                    ctx.fillRect(10, 22, 2, 1);
                    ctx.fillRect(20, 22, 2, 1);
                    // Sombra inferior do lábio
                    ctx.fillStyle = '#C66E3A';
                    ctx.fillRect(13, 24, 6, 1);
                });
            }
        }

        /**
         * ============================================================================
         * MÓDULO 3: MOTOR DE ÁUDIO ROMÂNTICO ORIGINAL (WEB AUDIO API)
         * Gera melodia ambiente suave estilo caixinha de música / Minecraft pôr do sol
         * e efeitos sonoros de clique cúbico, virar página e acorde de coração.
         * ============================================================================
         */
        class RomanticAudioEngine {
            constructor() {
                this.ctx = null;
                this.isMuted = true;
                this.ambientTimer = null;
                this.noteIndex = 0;

                // Melodia calma e acolhedora em Fá Maior / Dó Maior
                this.melodyNotes = [
                    261.63, 329.63, 392.00, 493.88,
                    349.23, 440.00, 523.25, 440.00,
                    293.66, 349.23, 440.00, 523.25,
                    392.00, 493.88, 587.33, 523.25
                ];
            }

            initContext() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) {
                        this.ctx = new AudioCtx();
                    }
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            ensureStartedOnFirstInteraction() {
                this.initContext();
                if (this.isMuted) {
                    this.toggleAudio(true);
                }
            }

            toggleAudio(forceState = null) {
                this.initContext();
                this.isMuted = forceState !== null ? !forceState : !this.isMuted;

                const iconEl = document.getElementById('audio-icon');
                const labelEl = document.getElementById('audio-label');

                if (!this.isMuted) {
                    if (iconEl) iconEl.textContent = '🔊';
                    if (labelEl) labelEl.textContent = 'Som: On';
                    this.startAmbientLoop();
                    this.playBlockClick(587.33);
                } else {
                    if (iconEl) iconEl.textContent = '🔇';
                    if (labelEl) labelEl.textContent = 'Som: Off';
                    this.stopAmbientLoop();
                }
            }

            startAmbientLoop() {
                this.stopAmbientLoop();
                if (this.isMuted || !this.ctx) return;

                const playNextAmbientNote = () => {
                    if (this.isMuted || !this.ctx) return;
                    const freq = this.melodyNotes[this.noteIndex % this.melodyNotes.length];
                    this.noteIndex++;

                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now);

                    gain.gain.setValueAtTime(0.001, now);
                    gain.gain.exponentialRampToValueAtTime(0.035, now + 0.35);
                    gain.gain.exponentialRampToValueAtTime(0.0008, now + 2.1);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now);
                    osc.stop(now + 2.2);
                };

                playNextAmbientNote();
                this.ambientTimer = setInterval(playNextAmbientNote, 2100);
            }

            stopAmbientLoop() {
                if (this.ambientTimer) {
                    clearInterval(this.ambientTimer);
                    this.ambientTimer = null;
                }
            }

            playBlockClick(freq = 440) {
                if (this.isMuted || !this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'triangle';
                osc.frequency.setValueAtTime(freq, now);
                osc.frequency.exponentialRampToValueAtTime(freq * 1.25, now + 0.08);

                gain.gain.setValueAtTime(0.07, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);

                osc.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start(now);
                osc.stop(now + 0.1);
            }

            playPageFlip() {
                if (this.isMuted || !this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(320, now);
                osc.frequency.exponentialRampToValueAtTime(640, now + 0.14);

                gain.gain.setValueAtTime(0.045, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.16);

                osc.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start(now);
                osc.stop(now + 0.17);
            }

            playHeartChime() {
                if (this.isMuted || !this.ctx) return;
                const chord = [523.25, 659.25, 783.99, 1046.50];
                chord.forEach((freq, idx) => {
                    const now = this.ctx.currentTime + idx * 0.09;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now);

                    gain.gain.setValueAtTime(0.001, now);
                    gain.gain.exponentialRampToValueAtTime(0.055, now + 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.0008, now + 0.85);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now);
                    osc.stop(now + 0.9);
                });
            }
        }

        /**
         * ============================================================================
         * MÓDULO 4: MUNDO 3D, PERSONAGEM GLB E LIVRO 3D (THREE.JS + GSAP)
         * ============================================================================
         */
        class VoxelLoveWorld3D {
            constructor(containerId) {
                this.container = document.getElementById(containerId);
                this.scene = new THREE.Scene();
                this.clock = new THREE.Clock();

                // Rig do personagem com articulações corrigidas
                this.mascotRoot = new THREE.Group();
                this.rig = {
                    headGroup: null,
                    torsoGroup: null,
                    leftShoulder: null,
                    leftElbow: null,
                    rightShoulder: null,
                    rightElbow: null
                };

                // Livro 3D
                this.bookGroup = new THREE.Group();
                this.bookFrontCoverPivot = new THREE.Group();

                // Partículas e Corações 3D
                this.goldenParticles = null;
                this.floatingHearts = [];
                this.clouds = [];

                // Interação de câmera suave
                this.pointerOffset = { x: 0, y: 0 };
                this.isDragging = false;
                this.dragStart = { x: 0, y: 0 };
                this.cameraOrbitAngle = 0;

                this.currentPose = 'Idle_Gesture';

                this.initRendererAndCamera();
                this.initSunsetLighting();
                this.buildVoxelEnvironment();
                this.build3DBook();
                this.buildArticulatedMascotFromSpec();
                this.bindPointerEvents();
            }

            initRendererAndCamera() {
                const w = window.innerWidth;
                const h = window.innerHeight;

                this.camera = new THREE.PerspectiveCamera(42, w / h, 0.1, 120);
                // Posição inicial (Cena 1): Personagem à esquerda, card à direita no desktop
                const isMobile = w < 768;
                this.baseCamPos = isMobile
                    ? { x: 0, y: 2.25, z: 6.2 }
                    : { x: 1.15, y: 1.85, z: 5.0 };
                this.baseLookAt = isMobile
                    ? new THREE.Vector3(0, 1.25, 0)
                    : new THREE.Vector3(0.85, 1.45, 0);

                this.camera.position.set(this.baseCamPos.x, this.baseCamPos.y, this.baseCamPos.z);
                this.camera.lookAt(this.baseLookAt);

                this.renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: "high-performance" });
                this.renderer.setSize(w, h);
                this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                this.renderer.shadowMap.enabled = true;
                this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;
                this.renderer.outputEncoding = THREE.sRGBEncoding;

                this.container.appendChild(this.renderer.domElement);

                // Neblina atmosférica rosa-pêssego/laranja do pôr do sol
                this.scene.fog = new THREE.FogExp2(0xFFA9B6, 0.028);
            }

            initSunsetLighting() {
                // Luz hemisférica com cores oficiais (#FFD13B no céu e #4B7931 no solo)

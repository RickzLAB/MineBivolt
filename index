            /**
             * Constrói o personagem 3D de alta fidelidade idêntico às imagens da prancha
             * e da foto "TE AMO (Day & Eu)":
             * - Cabelo cacheado/texturizado com dezenas de tufos em relevo 3D
             * - Óculos retangulares vazados com lentes translúcidas sobre o rosto expressivo
             * - Camiseta preta com mangas curtas + emblema vermelho pixel art + corrente prateada 3D
             * - Braços articulados com mangas pretas, antebraços, mãos com polegar e relógio prateado detalhado
             * - Calça cargo escura texturizada e tênis estilo skate preto/cinza com biqueira e sola branca
             */
            buildArticulatedMascotFromSpec() {
                const childrenToRemove = this.mascotRoot.children.filter(c => c !== this.bookGroup);
                childrenToRemove.forEach(c => this.mascotRoot.remove(c));

                const unitBox = new THREE.BoxGeometry(1, 1, 1);

                // Texturas Pixel Art geradas via Canvas
                const faceTex = VoxelTextureFactory.createFaceTexture();
                const skinTex = VoxelTextureFactory.createSkinTexture();
                const shirtFrontTex = VoxelTextureFactory.createShirtFrontTexture();
                const blackFabricTex = VoxelTextureFactory.createBlackFabricTexture();
                const cargoPantsTex = VoxelTextureFactory.createCargoPantsTexture();

                // Materiais ricos
                const skinMat = new THREE.MeshStandardMaterial({ map: skinTex, roughness: 0.55 });
                const skinLightMat = new THREE.MeshStandardMaterial({ color: 0xEDA068, roughness: 0.5 });
                const darkHairMat1 = new THREE.MeshStandardMaterial({ color: 0x22140E, roughness: 0.75 });
                const darkHairMat2 = new THREE.MeshStandardMaterial({ color: 0x2F1B12, roughness: 0.75 });
                const darkHairMat3 = new THREE.MeshStandardMaterial({ color: 0x180E09, roughness: 0.8 });

                const blackShirtMat = new THREE.MeshStandardMaterial({ map: blackFabricTex, roughness: 0.7 });
                const shirtMaterials = [
                    blackShirtMat, // Direita
                    blackShirtMat, // Esquerda
                    blackShirtMat, // Topo
                    blackShirtMat, // Baixo
                    new THREE.MeshStandardMaterial({ map: shirtFrontTex, roughness: 0.65 }), // Frente com emblema vermelho
                    blackShirtMat  // Costas
                ];

                const pantsMat = new THREE.MeshStandardMaterial({ map: cargoPantsTex, roughness: 0.8 });
                const glassesFrameMat = new THREE.MeshStandardMaterial({ color: 0x161311, roughness: 0.3, metalness: 0.2 });
                const lensMat = new THREE.MeshStandardMaterial({
                    color: 0xFFFFFF,
                    transparent: true,
                    opacity: 0.16,
                    roughness: 0.1,
                    metalness: 0.3
                });
                const silverMat = new THREE.MeshStandardMaterial({ color: 0xD0D7DE, metalness: 0.75, roughness: 0.25 });
                const watchDialMat = new THREE.MeshStandardMaterial({ color: 0x1E2229, roughness: 0.3 });
                const shoeDarkMat = new THREE.MeshStandardMaterial({ color: 0x1C1C21, roughness: 0.7 });
                const shoeGreyMat = new THREE.MeshStandardMaterial({ color: 0x7A7E85, roughness: 0.6 });
                const shoeWhiteSoleMat = new THREE.MeshStandardMaterial({ color: 0xF0EEE9, roughness: 0.5 });

                // Grupos hierárquicos para articulação perfeita
                this.rig.torsoGroup = new THREE.Group();
                this.rig.headGroup = new THREE.Group();
                this.rig.headGroup.position.set(0, 1.72, 0);

                this.rig.leftShoulder = new THREE.Group();
                this.rig.leftShoulder.position.set(-0.50, 1.56, 0);
                this.rig.leftElbow = new THREE.Group();
                this.rig.leftElbow.position.set(0, -0.38, 0);
                this.rig.leftShoulder.add(this.rig.leftElbow);

                this.rig.rightShoulder = new THREE.Group();
                this.rig.rightShoulder.position.set(0.50, 1.56, 0);
                this.rig.rightElbow = new THREE.Group();
                this.rig.rightElbow.position.set(0, -0.38, 0);
                this.rig.rightShoulder.add(this.rig.rightElbow);

                this.mascotRoot.add(
                    this.rig.torsoGroup,
                    this.rig.headGroup,
                    this.rig.leftShoulder,
                    this.rig.rightShoulder
                );

                const addVoxel = (parent, sx, sy, sz, px, py, pz, mat) => {
                    const m = new THREE.Mesh(unitBox, mat);
                    m.scale.set(sx, sy, sz);
                    m.position.set(px, py, pz);
                    m.castShadow = true;
                    m.receiveShadow = true;
                    parent.add(m);
                    return m;
                };

                // ====================================================================
                // 1. CABEÇA, ROSTO TEXTURIZADO, ÓCULOS VAZADOS E CABELO CACHEADO 3D
                // ====================================================================
                const headMaterials = [
                    skinMat, // Direita
                    skinMat, // Esquerda
                    skinMat, // Topo
                    skinMat, // Base
                    new THREE.MeshStandardMaterial({ map: faceTex, roughness: 0.5 }), // Rosto frontal
                    skinMat  // Nuca
                ];
                addVoxel(this.rig.headGroup, 0.78, 0.74, 0.68, 0, 0.40, 0, headMaterials);

                // Orelhas em voxel
                addVoxel(this.rig.headGroup, 0.08, 0.18, 0.14, -0.42, 0.36, -0.02, skinMat);
                addVoxel(this.rig.headGroup, 0.08, 0.18, 0.14,  0.42, 0.36, -0.02, skinMat);

                // Óculos 3D reais (aros vazados para mostrar os olhos, ponte, lentes e hastes laterais)
                const buildGlassesSide = (sideSign) => {
                    const cx = sideSign * 0.195;
                    const cy = 0.41;
                    const cz = 0.355;
                    // Aro superior (mais grosso e expressivo igual à imagem)
                    addVoxel(this.rig.headGroup, 0.30, 0.042, 0.04, cx, cy + 0.085, cz, glassesFrameMat);
                    // Aro inferior
                    addVoxel(this.rig.headGroup, 0.29, 0.028, 0.035, cx, cy - 0.085, cz, glassesFrameMat);
                    // Aro externo e interno
                    addVoxel(this.rig.headGroup, 0.035, 0.19, 0.04, cx + sideSign * 0.135, cy, cz, glassesFrameMat);
                    addVoxel(this.rig.headGroup, 0.032, 0.18, 0.038, cx - sideSign * 0.13, cy, cz, glassesFrameMat);
                    // Lente translúcida
                    addVoxel(this.rig.headGroup, 0.24, 0.14, 0.015, cx, cy, cz, lensMat);
                    // Haste lateral indo até a orelha
                    addVoxel(this.rig.headGroup, 0.03, 0.035, 0.36, sideSign * 0.40, cy + 0.03, 0.16, glassesFrameMat);
                };
                buildGlassesSide(-1);
                buildGlassesSide(1);
                // Ponte central dos óculos
                addVoxel(this.rig.headGroup, 0.11, 0.038, 0.04, 0, 0.44, 0.358, glassesFrameMat);

                // Cabelo Cacheado/Texturizado Voxel 3D (múltiplos cubos formando os cachos volumosos das imagens)
                // Base interna do cabelo
                addVoxel(this.rig.headGroup, 0.84, 0.24, 0.74, 0, 0.78, -0.01, darkHairMat1);
                addVoxel(this.rig.headGroup, 0.82, 0.56, 0.24, 0, 0.48, -0.27, darkHairMat1); // Parte de trás

                // Grade de cachos em relevo no topo e franja
                const hairMats = [darkHairMat1, darkHairMat2, darkHairMat3];
                for (let gx = -3; gx <= 3; gx++) {
                    for (let gz = -3; gz <= 3; gz++) {
                        const hMat = hairMats[Math.abs(gx * 3 + gz * 5) % hairMats.length];
                        const curlHeight = 0.12 + ((Math.abs(gx + gz) % 3) * 0.045);
                        const px = gx * 0.115;
                        const pz = gz * 0.105;
                        addVoxel(this.rig.headGroup, 0.125, curlHeight, 0.12, px, 0.88 + curlHeight * 0.3, pz, hMat);
                    }
                }

                // Franja frontal texturizada (com os pequenos degraus na testa igual à referência)
                const fringeHeights = [0.16, 0.13, 0.18, 0.14, 0.17, 0.13, 0.16];
                for (let i = 0; i < 7; i++) {
                    const fx = (i - 3) * 0.115;
                    const fh = fringeHeights[i];
                    const hMat = hairMats[i % hairMats.length];
                    addVoxel(this.rig.headGroup, 0.125, fh, 0.13, fx, 0.74 - fh * 0.25, 0.33, hMat);
                }

                // Laterais e costeletas texturizadas acima das orelhas
                [-1, 1].forEach(side => {
                    for (let sy = 0; sy < 4; sy++) {
                        for (let sz = -2; sz <= 2; sz++) {
                            if (sy === 0 && sz > 0) continue; // Abre espaço para a orelha
                            const hMat = hairMats[(sy + Math.abs(sz)) % hairMats.length];
                            addVoxel(
                                this.rig.headGroup,
                                0.10, 0.13, 0.13,
                                side * 0.41,
                                0.42 + sy * 0.11,
                                sz * 0.12,
                                hMat
                            );
                        }
                    }
                    // Costeleta curta ao lado dos óculos
                    addVoxel(this.rig.headGroup, 0.08, 0.18, 0.09, side * 0.40, 0.44, 0.22, darkHairMat1);
                });

                // ====================================================================
                // 2. PESCOÇO, TORSO (CAMISETA PRETA + EMBLEMA) E CORRENTE PRATEADA 3D
                // ====================================================================
                addVoxel(this.rig.torsoGroup, 0.28, 0.22, 0.26, 0, 1.72, 0, skinMat);
                addVoxel(this.rig.torsoGroup, 0.76, 0.78, 0.40, 0, 1.28, 0, shirtMaterials);

                // Corrente prateada em blocos 3D ao redor do pescoço + pingente circular
                const chainSegments = [
                    [-0.17, 1.66, 0.19], [-0.15, 1.60, 0.205], [-0.12, 1.54, 0.21],
                    [-0.09, 1.48, 0.212], [-0.05, 1.43, 0.215],
                    [ 0.17, 1.66, 0.19], [ 0.15, 1.60, 0.205], [ 0.12, 1.54, 0.21],
                    [ 0.09, 1.48, 0.212], [ 0.05, 1.43, 0.215]
                ];
                chainSegments.forEach(([cx, cy, cz]) => {
                    addVoxel(this.rig.torsoGroup, 0.036, 0.055, 0.03, cx, cy, cz, silverMat);
                });
                // Argola/Pingente prateado centralizado acima do símbolo vermelho
                addVoxel(this.rig.torsoGroup, 0.09, 0.09, 0.035, 0, 1.37, 0.218, silverMat);
                addVoxel(this.rig.torsoGroup, 0.045, 0.045, 0.04, 0, 1.37, 0.22, blackShirtMat); // Furo da argola

                // ====================================================================
                // 3. BRAÇOS COM MANGAS PRETAS, MÃOS DETALHADAS E RELÓGIO PRATEADO
                // ====================================================================
                // Braço Esquerdo (com o relógio prateado da imagem no pulso)
                addVoxel(this.rig.leftShoulder, 0.28, 0.26, 0.30, 0, -0.08, 0, blackShirtMat); // Manga preta
                addVoxel(this.rig.leftShoulder, 0.23, 0.22, 0.25, 0, -0.28, 0, skinMat);       // Bíceps

                addVoxel(this.rig.leftElbow, 0.22, 0.36, 0.24, 0, -0.16, 0, skinMat);          // Antebraço
                // Relógio prateado robusto com mostrador escuro e moldura metálica
                addVoxel(this.rig.leftElbow, 0.245, 0.09, 0.265, 0, -0.27, 0.01, silverMat);   // Pulseira metálica
                addVoxel(this.rig.leftElbow, 0.15, 0.13, 0.04, 0, -0.27, 0.145, silverMat);    // Caixa do relógio
                addVoxel(this.rig.leftElbow, 0.11, 0.09, 0.045, 0, -0.27, 0.148, watchDialMat);// Mostrador escuro
                // Mão esquerda + polegar/dedos para apontar
                addVoxel(this.rig.leftElbow, 0.21, 0.17, 0.23, 0, -0.41, 0.02, skinLightMat);
                addVoxel(this.rig.leftElbow, 0.07, 0.09, 0.09, 0.09, -0.39, 0.12, skinLightMat); // Polegar

                // Braço Direito
                addVoxel(this.rig.rightShoulder, 0.28, 0.26, 0.30, 0, -0.08, 0, blackShirtMat); // Manga preta
                addVoxel(this.rig.rightShoulder, 0.23, 0.22, 0.25, 0, -0.28, 0, skinMat);       // Bíceps

                addVoxel(this.rig.rightElbow, 0.22, 0.36, 0.24, 0, -0.16, 0, skinMat);          // Antebraço
                // Mão direita + indicador/polegar expressivo
                addVoxel(this.rig.rightElbow, 0.21, 0.17, 0.23, 0, -0.41, 0.02, skinLightMat);
                addVoxel(this.rig.rightElbow, 0.07, 0.09, 0.09, -0.09, -0.39, 0.12, skinLightMat);

                // ====================================================================
                // 4. CALÇA CARGO ESCURA COM BOLSOS LATERAIS E TÊNIS DETALHADOS
                // ====================================================================
                // Cós/Quadril
                addVoxel(this.rig.torsoGroup, 0.74, 0.14, 0.38, 0, 0.84, 0, pantsMat);

                // Pernas com leve abertura natural em "A" igual às poses da prancha
                const buildLegAndShoe = (sideSign) => {
                    const legGroup = new THREE.Group();
                    legGroup.position.set(sideSign * 0.195, 0.80, 0);
                    legGroup.rotation.z = sideSign * 0.045; // Postura estilosa da prancha

                    // Coxa e Canela Cargo
                    addVoxel(legGroup, 0.33, 0.56, 0.35, 0, -0.26, 0, pantsMat);
                    // Bolso Cargo 3D na lateral da perna
                    addVoxel(legGroup, 0.05, 0.20, 0.20, sideSign * 0.18, -0.24, 0.02, pantsMat);

                    // Tênis (Sola branca, corpo preto, detalhes cinzas e cadarço/biqueira branca)
                    addVoxel(legGroup, 0.36, 0.07, 0.48, 0, -0.74, 0.05, shoeWhiteSoleMat); // Sola branca
                    addVoxel(legGroup, 0.35, 0.14, 0.38, 0, -0.64, 0.01, shoeDarkMat);      // Corpo do tênis
                    addVoxel(legGroup, 0.33, 0.09, 0.14, 0, -0.66, 0.22, shoeWhiteSoleMat); // Biqueira clara
                    addVoxel(legGroup, 0.24, 0.06, 0.16, 0, -0.57, 0.12, shoeGreyMat);      // Língua/cadarço cinza

                    this.rig.torsoGroup.add(legGroup);
                };
                buildLegAndShoe(-1);
                buildLegAndShoe(1);

                this.mascotRoot.position.set(0, 0, 0);
                this.scene.add(this.mascotRoot);
                this.setCharacterPose('Idle_Gesture', 0.1);
            }

            /**
             * Controla as 5 poses/animações oficiais do personagem conforme a prancha visual:
             * 1. Point_Next_Page (Apontar para a próxima página / botão)
             * 2. Point_At_Text (Apontar para o texto)
             * 3. Explain_Content (Acompanhar fragmentos de texto)
             * 4. Hug (Gesto de abraço com braços abertos)
             * 5. Idle_Gesture / Hold_Book (Espera acolhedora / Segurar livro)
             */
            setCharacterPose(poseName, duration = 0.65) {
                this.currentPose = poseName;
                if (!this.rig.leftShoulder || !this.rig.rightShoulder) return;

                const poses = {
                    // Pose de espera acolhedora
                    'Idle_Gesture': {
                        lShoulder: { x: 0.08, y: 0, z: 0.08 },
                        lElbow:    { x: -0.18, y: 0, z: 0 },
                        rShoulder: { x: 0.12, y: 0, z: -0.1 },
                        rElbow:    { x: -0.25, y: 0, z: 0 },
                        head:      { x: 0.02, y: 0.12, z: -0.03 },
                        rootRotY:  0.18
                    },
                    // 1. Apontar para o botão / próxima página (prancha 1)
                    'Point_Next_Page': {
                        lShoulder: { x: 0.15, y: 0, z: 0.12 },
                        lElbow:    { x: -0.25, y: 0, z: 0 },
                        rShoulder: { x: -1.15, y: -0.35, z: -0.45 },
                        rElbow:    { x: -0.35, y: 0, z: 0 },
                        head:      { x: -0.04, y: 0.25, z: 0.05 },
                        rootRotY:  0.22
                    },
                    // Segurando o livro fechado nas duas mãos (Cena 2A)
                    'Hold_Book': {
                        lShoulder: { x: -0.78, y: 0.32, z: 0.18 },
                        lElbow:    { x: -0.65, y: 0.2, z: 0 },
                        rShoulder: { x: -0.78, y: -0.32, z: -0.18 },
                        rElbow:    { x: -0.65, y: -0.2, z: 0 },
                        head:      { x: 0.12, y: 0, z: 0 },
                        rootRotY:  0.0
                    },
                    // 2. Apontar para o texto (prancha 2)
                    'Point_At_Text': {
                        lShoulder: { x: 0.15, y: 0, z: 0.12 },
                        lElbow:    { x: -0.25, y: 0, z: 0 },
                        rShoulder: { x: -1.05, y: -0.28, z: -0.38 },
                        rElbow:    { x: -0.45, y: 0, z: 0 },
                        head:      { x: 0.0, y: 0.22, z: 0.04 },
                        rootRotY:  0.28
                    },
                    // 3. Acompanhar fragmentos de texto (prancha 3)
                    'Explain_Content': {
                        lShoulder: { x: -0.55, y: 0.22, z: 0.15 },
                        lElbow:    { x: -0.65, y: 0, z: 0 },
                        rShoulder: { x: -0.95, y: -0.2, z: -0.28 },
                        rElbow:    { x: -0.55, y: 0.15, z: 0 },
                        head:      { x: -0.05, y: 0.18, z: -0.04 },
                        rootRotY:  0.24
                    },
                    // 4. Gesto de Abraço aberto (prancha 4)
                    'Hug': {
                        lShoulder: { x: -1.05, y: -0.35, z: 0.85 },
                        lElbow:    { x: -0.35, y: 0.2, z: 0 },
                        rShoulder: { x: -1.05, y: 0.35, z: -0.85 },
                        rElbow:    { x: -0.35, y: -0.2, z: 0 },
                        head:      { x: -0.06, y: 0, z: 0.04 },
                        rootRotY:  0.0
                    }
                };

                const target = poses[poseName] || poses['Idle_Gesture'];

                gsap.to(this.rig.leftShoulder.rotation, { ...target.lShoulder, duration, ease: "power2.out" });
                gsap.to(this.rig.leftElbow.rotation, { ...target.lElbow, duration, ease: "power2.out" });
                gsap.to(this.rig.rightShoulder.rotation, { ...target.rShoulder, duration, ease: "power2.out" });
                gsap.to(this.rig.rightElbow.rotation, { ...target.rElbow, duration, ease: "power2.out" });
                gsap.to(this.rig.headGroup.rotation, { ...target.head, duration, ease: "power2.out" });
                gsap.to(this.mascotRoot.rotation, { y: target.rootRotY, x: 0, duration, ease: "power2.out" });
            }

            /**
             * Animação especial quando Dayane clica em "Receber abraço virtual":
             * O personagem inclina levemente o corpo para a frente, aproxima os braços
             * em um abraço carinhoso, emite corações e retorna aos braços abertos.
             */
            triggerWarmEmbraceAnimation(onComplete) {
                const tl = gsap.timeline({
                    onComplete: () => {
                        this.setCharacterPose('Hug', 0.7);
                        if (onComplete) onComplete();
                    }
                });

                // 1. Inclina suavemente para a frente e fecha os braços no abraço
                tl.to(this.mascotRoot.position, { z: 0.45, duration: 0.55, ease: "power2.out" }, 0)
                  .to(this.mascotRoot.rotation, { x: 0.12, duration: 0.55, ease: "power2.out" }, 0)
                  .to(this.rig.leftShoulder.rotation, { x: -1.25, y: 0.48, z: 0.15, duration: 0.55, ease: "back.out(1.4)" }, 0)
                  .to(this.rig.leftElbow.rotation, { x: -0.85, y: 0.35, z: 0, duration: 0.55 }, 0)
                  .to(this.rig.rightShoulder.rotation, { x: -1.25, y: -0.48, z: -0.15, duration: 0.55, ease: "back.out(1.4)" }, 0)
                  .to(this.rig.rightElbow.rotation, { x: -0.85, y: -0.35, z: 0, duration: 0.55 }, 0)
                  // 2. Mantém o abraço aconchegante por um instante e retorna
                  .to(this.mascotRoot.position, { z: 0, duration: 0.75, ease: "power2.inOut" }, "+=0.65")
                  .to(this.mascotRoot.rotation, { x: 0, duration: 0.75, ease: "power2.inOut" }, "<");

                this.burstExtraHearts(14);
            }

            burstExtraHearts(count = 10) {
                for (let i = 0; i < count; i++) {
                    const heart = this.createVoxelHeartMesh(0.075);
                    heart.position.set(
                        this.mascotRoot.position.x + (Math.random() - 0.5) * 1.4,
                        1.3 + Math.random() * 0.9,
                        this.mascotRoot.position.z + 0.3 + (Math.random() - 0.5) * 0.6
                    );
                    this.scene.add(heart);

                    gsap.to(heart.position, {
                        y: heart.position.y + 1.8 + Math.random() * 1.2,
                        x: heart.position.x + (Math.random() - 0.5) * 1.6,
                        duration: 1.8 + Math.random() * 0.8,
                        ease: "power1.out",
                        onComplete: () => {
                            this.scene.remove(heart);
                        }
                    });
                    gsap.to(heart.rotation, {
                        y: Math.PI * 2,
                        duration: 1.8,
                        ease: "none"
                    });
                }
            }

            /**
             * Transições de câmera e objetos 3D entre as 3 cenas principais
             */
            transitionToScene(sceneName, onComplete) {
                const isMobile = window.innerWidth < 768;

                if (sceneName === 'SCENE_1_INTRO') {
                    this.bookGroup.visible = false;
                    this.setCharacterPose('Idle_Gesture', 0.6);

                    const targetCam = isMobile
                        ? { x: 0, y: 2.25, z: 6.2 }
                        : { x: 1.15, y: 1.85, z: 5.0 };
                    const targetLook = isMobile
                        ? { x: 0, y: 1.25, z: 0 }
                        : { x: 0.85, y: 1.45, z: 0 };

                    gsap.to(this.baseCamPos, { ...targetCam, duration: 1.1, ease: "power2.inOut" });
                    gsap.to(this.baseLookAt, { ...targetLook, duration: 1.1, ease: "power2.inOut", onComplete });
                }

                else if (sceneName === 'SCENE_2_BOOK_CLOSED') {
                    this.bookGroup.visible = true;
                    this.bookFrontCoverPivot.rotation.y = 0;
                    this.bookGroup.position.set(-0.22, 1.12, 0.52);
                    this.bookGroup.rotation.set(-0.4, 0.1, 0);
                    gsap.fromTo(this.bookGroup.scale,
                        { x: 0.01, y: 0.01, z: 0.01 },
                        { x: 1, y: 1, z: 1, duration: 0.8, ease: "back.out(1.6)" }
                    );

                    this.setCharacterPose('Hold_Book', 0.8);

                    const targetCam = isMobile
                        ? { x: 0, y: 1.85, z: 4.6 }
                        : { x: 0, y: 1.75, z: 3.8 };
                    const targetLook = isMobile
                        ? { x: 0, y: 1.15, z: 0 }
                        : { x: 0, y: 1.35, z: 0 };

                    gsap.to(this.baseCamPos, { ...targetCam, duration: 1.1, ease: "power2.inOut" });
                    gsap.to(this.baseLookAt, { ...targetLook, duration: 1.1, ease: "power2.inOut", onComplete });
                }

                else if (sceneName === 'SCENE_2_BOOK_OPEN') {
                    // Animação cinematográfica: o livro flutua, aproxima-se e abre a capa 3D
                    const tl = gsap.timeline({ onComplete });

                    tl.to(this.bookGroup.position, {
                        x: isMobile ? -0.15 : 0.35,
                        y: 1.48,
                        z: 1.35,
                        duration: 0.75,
                        ease: "power2.out"
                    }, 0)
                    .to(this.bookGroup.rotation, {
                        x: 0.1,
                        y: -0.2,
                        z: 0,
                        duration: 0.75,
                        ease: "power2.out"
                    }, 0)
                    .to(this.bookFrontCoverPivot.rotation, {
                        y: -Math.PI * 0.82,
                        duration: 0.65,
                        ease: "power2.inOut"
                    }, 0.35)
                    .to(this.bookGroup.scale, {
                        x: 0.001,
                        y: 0.001,
                        z: 0.001,
                        duration: 0.35,
                        ease: "power2.in",
                        onComplete: () => {
                            this.bookGroup.visible = false;
                        }
                    }, 0.85);

                    // Posiciona câmera para deixar o personagem visível ao lado do livro aberto
                    const targetCam = isMobile
                        ? { x: 0, y: 2.35, z: 6.4 }
                        : { x: 1.25, y: 1.75, z: 4.6 };
                    const targetLook = isMobile
                        ? { x: 0, y: 1.15, z: 0 }
                        : { x: 0.95, y: 1.4, z: 0 };

                    gsap.to(this.baseCamPos, { ...targetCam, duration: 1.0, ease: "power2.inOut" });
                    gsap.to(this.baseLookAt, { ...targetLook, duration: 1.0, ease: "power2.inOut" });

                    this.setCharacterPose('Point_At_Text', 0.8);
                }

                else if (sceneName === 'SCENE_3_HUG') {
                    // Sequência de fechamento do livro e revelação do abraço no pôr do sol
                    this.bookGroup.visible = true;
                    this.bookGroup.position.set(0.1, 1.45, 1.1);
                    this.bookGroup.scale.set(1, 1, 1);
                    this.bookFrontCoverPivot.rotation.y = -Math.PI * 0.82;

                    const tl = gsap.timeline({
                        onComplete: () => {
                            this.bookGroup.visible = false;
                            this.setCharacterPose('Hug', 0.85);
                            this.burstExtraHearts(16);
                            if (onComplete) onComplete();
                        }
                    });

                    // Fecha a capa do livro 3D lentamente e recolhe
                    tl.to(this.bookFrontCoverPivot.rotation, {
                        y: 0,
                        duration: 0.6,
                        ease: "power2.inOut"
                    }, 0)
                    .to(this.bookGroup.position, {
                        x: -0.2,
                        y: 1.15,
                        z: 0.4,
                        duration: 0.55,
                        ease: "power2.in"
                    }, 0.35)
                    .to(this.bookGroup.scale, {
                        x: 0.001,
                        y: 0.001,
                        z: 0.001,
                        duration: 0.45,
                        ease: "back.in(1.4)"
                    }, 0.45);

                    // Iluminação mais quente e acolhedora para a cena final
                    gsap.to(this.sunLight, { intensity: 1.4, duration: 1.2 });
                    gsap.to(this.warmRimLight, { intensity: 1.35, duration: 1.2 });

                    const targetCam = isMobile
                        ? { x: 0, y: 2.05, z: 5.5 }
                        : { x: 0, y: 1.8, z: 4.3 };
                    const targetLook = isMobile
                        ? { x: 0, y: 1.15, z: 0 }
                        : { x: 0, y: 1.42, z: 0 };

                    gsap.to(this.baseCamPos, { ...targetCam, duration: 1.2, ease: "power2.inOut" });
                    gsap.to(this.baseLookAt, { ...targetLook, duration: 1.2, ease: "power2.inOut" });
                }
            }

            bindPointerEvents() {
                window.addEventListener('mousemove', (e) => {
                    this.pointerOffset.x = (e.clientX / window.innerWidth - 0.5) * 2;
                    this.pointerOffset.y = (e.clientY / window.innerHeight - 0.5) * 2;

                    if (this.isDragging) {
                        const dx = e.clientX - this.dragStart.x;
                        this.cameraOrbitAngle = Math.max(-0.45, Math.min(0.45, this.cameraOrbitAngle + dx * 0.004));
                        this.dragStart.x = e.clientX;
                    }
                });

                this.container.addEventListener('mousedown', (e) => {
                    this.isDragging = true;
                    this.dragStart.x = e.clientX;
                });

                window.addEventListener('mouseup', () => {
                    this.isDragging = false;
                });

                window.addEventListener('resize', () => this.onWindowResize());
            }

            onWindowResize() {
                const w = window.innerWidth;
                const h = window.innerHeight;
                this.camera.aspect = w / h;
                this.camera.updateProjectionMatrix();
                this.renderer.setSize(w, h);
            }

            animateLoop() {
                requestAnimationFrame(() => this.animateLoop());

                const elapsed = this.clock.getElapsedTime();

                // Respiração sutil e vida no personagem 3D
                if (this.mascotRoot && this.rig.torsoGroup) {
                    this.mascotRoot.position.y = Math.sin(elapsed * 2.2) * 0.025;
                    if (this.currentPose === 'Idle_Gesture' && this.rig.rightShoulder) {
                        this.rig.rightShoulder.rotation.z = -0.1 + Math.sin(elapsed * 2.5) * 0.04;
                    }
                }

                // Flutuação suave do Livro 3D quando visível
                if (this.bookGroup && this.bookGroup.visible) {
                    this.bookGroup.position.y += Math.sin(elapsed * 3.2) * 0.0008;
                }

                // Animação dos corações 3D e partículas douradas
                this.floatingHearts.forEach((h) => {
                    h.position.y = h.userData.baseY + Math.sin(elapsed * h.userData.speed + h.userData.phase) * 0.18;
                    h.rotation.y = elapsed * 0.8 + h.userData.phase;
                });

                if (this.goldenParticles) {
                    this.goldenParticles.rotation.y = elapsed * 0.04;
                }

                // Movimento lento das nuvens em blocos
                this.clouds.forEach((c, idx) => {
                    c.position.x += 0.003 * ((idx % 2 === 0) ? 1 : 0.7);
                    if (c.position.x > 14) c.position.x = -14;
                });

                // Parallax suave de câmera com mouse + órbita
                const targetX = this.baseCamPos.x + this.pointerOffset.x * 0.18 + Math.sin(this.cameraOrbitAngle) * 1.2;
                const targetY = this.baseCamPos.y - this.pointerOffset.y * 0.1;
                this.camera.position.x += (targetX - this.camera.position.x) * 0.06;
                this.camera.position.y += (targetY - this.camera.position.y) * 0.06;
                this.camera.position.z += (this.baseCamPos.z - this.camera.position.z) * 0.06;
                this.camera.lookAt(this.baseLookAt);

                this.renderer.render(this.scene, this.camera);
            }
        }

        /**
         * ============================================================================
         * MÓDULO 5: CONTROLADOR DE ESTADOS, LIVRO DE 8 PÁGINAS E INTERAÇÕES
         * ============================================================================
         */
        const AppState = {
            SCENE_1_INTRO: 'SCENE_1_INTRO',
            TRANSITIONING: 'TRANSITIONING',
            SCENE_2_BOOK_CLOSED: 'SCENE_2_BOOK_CLOSED',
            SCENE_2_BOOK_OPEN: 'SCENE_2_BOOK_OPEN',
            PAGE_TURNING: 'PAGE_TURNING',
            SCENE_3_HUG: 'SCENE_3_HUG'
        };

        class LoveAdventureController {
            constructor(world3D, audioEngine) {
                this.world = world3D;
                this.audio = audioEngine;
                this.state = AppState.SCENE_1_INTRO;
                this.currentPageIndex = 0;

                // Suporte a gestos de swipe no celular
                this.touchStartX = 0;
                this.touchEndX = 0;

                this.cacheDOM();
                this.buildProgressBlocks();
                this.renderPageContent(0);
                this.bindEvents();
            }

            cacheDOM() {
                this.scene1UI = document.getElementById('scene-1-ui');
                this.scene2ClosedUI = document.getElementById('scene-2-closed-ui');
                this.scene2OpenUI = document.getElementById('scene-2-open-ui');
                this.scene3HugUI = document.getElementById('scene-3-hug-ui');
                this.webglContainer = document.getElementById('webgl-container');

                this.btnEnterWorld = document.getElementById('btn-enter-world');
                this.btnOpenBook = document.getElementById('btn-open-book');
                this.btnPrevPage = document.getElementById('btn-prev-page');
                this.btnNextPage = document.getElementById('btn-next-page');
                this.btnNextPageText = document.getElementById('btn-next-page-text');
                this.hotspotPrev = document.getElementById('hotspot-prev-page');
                this.hotspotNext = document.getElementById('hotspot-next-page');

                this.bookPageSheet = document.getElementById('book-page-sheet');
                this.pageCurlShadow = document.getElementById('page-curl-shadow');
                this.pageBadgeNumber = document.getElementById('page-badge-number');
                this.pageDecorativeIcons = document.getElementById('page-decorative-icons');
                this.pageTitle = document.getElementById('page-title');
                this.pageText = document.getElementById('page-text');
                this.pageContentScroll = document.getElementById('page-content-scroll');
                this.pageFooterNote = document.getElementById('page-footer-note');
                this.pageProgressLabel = document.getElementById('page-progress-label');
                this.pageProgressBlocks = document.getElementById('page-progress-blocks');

                this.btnReceiveHug = document.getElementById('btn-receive-hug');
                this.btnReopenBook = document.getElementById('btn-reopen-book');
                this.btnResetJourney = document.getElementById('btn-reset-journey');
                this.hugFeedbackMessage = document.getElementById('hug-feedback-message');
            }

            buildProgressBlocks() {
                this.pageProgressBlocks.innerHTML = '';
                for (let i = 0; i < DECLARATION_PAGES.length; i++) {
                    const block = document.createElement('div');
                    block.className = 'h-full rounded-sm border border-[#222222] transition-colors duration-300';
                    this.pageProgressBlocks.appendChild(block);
                }
            }

            renderPageContent(pageIdx) {
                const page = DECLARATION_PAGES[pageIdx];
                if (!page) return;

                this.pageBadgeNumber.textContent = page.number;
                this.pageTitle.textContent = page.title;
                this.pageText.textContent = page.text;
                this.pageFooterNote.textContent = page.footerNote;
                this.pageProgressLabel.textContent = page.progressText;
                this.pageContentScroll.scrollTop = 0;

                // Ícones decorativos da página
                this.pageDecorativeIcons.innerHTML = page.icons
                    .map(ic => `<span>${ic}</span>`)
                    .join('');

                // Atualiza os 8 blocos de progresso
                Array.from(this.pageProgressBlocks.children).forEach((bar, idx) => {
                    if (idx < pageIdx) {
                        bar.style.backgroundColor = '#4B7931'; // Verde concluído
                    } else if (idx === pageIdx) {
                        bar.style.backgroundColor = '#E02424'; // Vermelho coração atual
                    } else {
                        bar.style.backgroundColor = '#FFA9B6'; // Rosa suave pendente
                    }
                });

                // Atualiza estado dos botões Anterior e Próxima
                this.btnPrevPage.disabled = (pageIdx === 0);
                this.hotspotPrev.style.display = (pageIdx === 0) ? 'none' : 'flex';

                if (pageIdx === DECLARATION_PAGES.length - 1) {
                    this.btnNextPageText.textContent = "Fechar Livro e Receber Carinho ❤️";
                    this.btnNextPage.classList.add('mc-btn-red');
                } else {
                    this.btnNextPageText.textContent = "Próxima Página";
                    this.btnNextPage.classList.remove('mc-btn-red');
                }
            }

            bindEvents() {
                // Controle de som
                document.getElementById('btn-audio-toggle').addEventListener('click', () => {
                    this.audio.toggleAudio();
                });

                // Hover e foco no botão da Cena 1 faz o personagem apontar para a interação
                this.btnEnterWorld.addEventListener('mouseenter', () => {
                    if (this.state === AppState.SCENE_1_INTRO) {
                        this.world.setCharacterPose('Point_Next_Page', 0.45);
                    }
                });
                this.btnEnterWorld.addEventListener('mouseleave', () => {
                    if (this.state === AppState.SCENE_1_INTRO) {
                        this.world.setCharacterPose('Idle_Gesture', 0.55);
                    }
                });

                // Clique no botão principal da Cena 1 -> Transição para Cena 2 (Livro Fechado)
                this.btnEnterWorld.addEventListener('click', () => {
                    if (this.state !== AppState.SCENE_1_INTRO) return;
                    this.audio.ensureStartedOnFirstInteraction();
                    this.audio.playBlockClick(523.25);
                    this.goToScene2BookClosed();
                });

                // Clique em "Clique aqui para amar mais" -> Abre o Livro 3D e exibe as 8 páginas
                this.btnOpenBook.addEventListener('click', () => {
                    if (this.state !== AppState.SCENE_2_BOOK_CLOSED) return;
                    this.audio.playPageFlip();
                    this.audio.playHeartChime();
                    this.goToScene2BookOpen();
                });

                // Botões e bordas de página anterior / próxima
                this.btnPrevPage.addEventListener('click', () => this.turnPage(-1));
                this.hotspotPrev.addEventListener('click', () => this.turnPage(-1));
                this.btnNextPage.addEventListener('click', () => this.turnPage(1));
                this.hotspotNext.addEventListener('click', () => this.turnPage(1));

                // Teclado (Setas esquerda e direita) durante leitura do livro
                window.addEventListener('keydown', (e) => {
                    if (this.state !== AppState.SCENE_2_BOOK_OPEN) return;
                    if (e.key === 'ArrowRight') this.turnPage(1);
                    if (e.key === 'ArrowLeft') this.turnPage(-1);
                });

                // Gestos de Swipe (toque) na página do livro
                this.bookPageSheet.addEventListener('touchstart', (e) => {
                    this.touchStartX = e.changedTouches[0].screenX;
                }, { passive: true });

                this.bookPageSheet.addEventListener('touchend', (e) => {
                    this.touchEndX = e.changedTouches[0].screenX;
                    const diff = this.touchStartX - this.touchEndX;
                    if (Math.abs(diff) > 48) {
                        if (diff > 0) this.turnPage(1);
                        else this.turnPage(-1);
                    }
                }, { passive: true });

                // Botão "Receber abraço virtual" na Cena 3
                this.btnReceiveHug.addEventListener('click', () => {
                    if (this.state !== AppState.SCENE_3_HUG) return;
                    this.audio.playHeartChime();
                    this.hugFeedbackMessage.textContent = "Sinta todo o meu carinho te envolvendo agora, mi momozin! Eu te amo infinitamente! ❤️🤗";
                    this.world.triggerWarmEmbraceAnimation();
                });

                // Botão "Rever o nosso livro"
                this.btnReopenBook.addEventListener('click', () => {
                    if (this.state !== AppState.SCENE_3_HUG) return;
                    this.audio.playPageFlip();
                    this.currentPageIndex = 0;
                    this.renderPageContent(0);
                    this.switchUI(this.scene3HugUI, this.scene2OpenUI);
                    this.webglContainer.classList.add('book-focus');
                    this.state = AppState.TRANSITIONING;
                    this.world.transitionToScene('SCENE_2_BOOK_OPEN', () => {
                        this.state = AppState.SCENE_2_BOOK_OPEN;
                    });
                });

                // Botão de voltar ao início
                this.btnResetJourney.addEventListener('click', () => {
                    if (this.state === AppState.TRANSITIONING || this.state === AppState.PAGE_TURNING) return;
                    this.audio.playBlockClick(392.00);
                    this.webglContainer.classList.remove('book-focus');
                    this.btnResetJourney.classList.add('hidden');

                    const activeUI = [this.scene2ClosedUI, this.scene2OpenUI, this.scene3HugUI]
                        .find(el => !el.classList.contains('hidden'));

                    this.state = AppState.TRANSITIONING;
                    if (activeUI) {
                        this.switchUI(activeUI, this.scene1UI);
                    }
                    this.world.transitionToScene('SCENE_1_INTRO', () => {
                        this.state = AppState.SCENE_1_INTRO;
                    });
                });
            }

            switchUI(hideEl, showEl) {
                if (hideEl) {
                    hideEl.classList.remove('opacity-100');
                    hideEl.classList.add('opacity-0');
                    setTimeout(() => {
                        hideEl.classList.add('hidden');
                        hideEl.classList.remove('flex');
                    }, 480);
                }
                if (showEl) {
                    setTimeout(() => {
                        showEl.classList.remove('hidden');
                        showEl.classList.add('flex');
                        requestAnimationFrame(() => {
                            showEl.classList.remove('opacity-0');
                            showEl.classList.add('opacity-100');
                        });
                    }, 350);
                }
            }

            goToScene2BookClosed() {
                this.state = AppState.TRANSITIONING;
                this.world.setCharacterPose('Point_Next_Page', 0.35);
                this.btnResetJourney.classList.remove('hidden');

                this.switchUI(this.scene1UI, this.scene2ClosedUI);
                this.world.transitionToScene('SCENE_2_BOOK_CLOSED', () => {
                    this.state = AppState.SCENE_2_BOOK_CLOSED;
                });
            }

            goToScene2BookOpen() {
                this.state = AppState.TRANSITIONING;
                this.currentPageIndex = 0;
                this.renderPageContent(0);
                this.webglContainer.classList.add('book-focus');

                this.switchUI(this.scene2ClosedUI, this.scene2OpenUI);
                this.world.transitionToScene('SCENE_2_BOOK_OPEN', () => {
                    this.state = AppState.SCENE_2_BOOK_OPEN;
                });
            }

            turnPage(direction) {
                if (this.state !== AppState.SCENE_2_BOOK_OPEN) return;

                const targetIndex = this.currentPageIndex + direction;

                // Se estiver na página 08 e clicar em avançar, inicia a Cena Final do Abraço
                if (targetIndex >= DECLARATION_PAGES.length) {
                    this.goToScene3Hug();
                    return;
                }

                if (targetIndex < 0) return;

                this.state = AppState.PAGE_TURNING;
                this.audio.playPageFlip();

                const animClass = direction > 0 ? 'turning-next' : 'turning-prev';
                this.pageCurlShadow.style.opacity = '1';
                this.bookPageSheet.classList.remove('turning-next', 'turning-prev');
                void this.bookPageSheet.offsetWidth; // Reflow para reiniciar animação CSS 3D
                this.bookPageSheet.classList.add(animClass);

                // Gesto do personagem acompanhando a mudança de página
                this.world.setCharacterPose('Point_Next_Page', 0.3);

                // Troca o texto exatamente na metade do giro 3D da folha (90 graus)
                setTimeout(() => {
                    this.currentPageIndex = targetIndex;
                    this.renderPageContent(this.currentPageIndex);
                    const nextPose = DECLARATION_PAGES[this.currentPageIndex].characterPose;
                    this.world.setCharacterPose(nextPose, 0.5);
                }, 310);

                setTimeout(() => {
                    this.bookPageSheet.classList.remove(animClass);
                    this.pageCurlShadow.style.opacity = '0';
                    this.state = AppState.SCENE_2_BOOK_OPEN;
                }, 690);
            }

            goToScene3Hug() {
                this.state = AppState.TRANSITIONING;
                this.audio.playHeartChime();
                this.webglContainer.classList.remove('book-focus');

                this.switchUI(this.scene2OpenUI, this.scene3HugUI);
                this.world.transitionToScene('SCENE_3_HUG', () => {
                    this.state = AppState.SCENE_3_HUG;
                });
            }
        }

        function showToast(message) {
            const toast = document.getElementById('voxel-toast');
            if (!toast) return;
            toast.textContent = message;
            toast.classList.remove('hidden');
            clearTimeout(toast._timer);
            toast._timer = setTimeout(() => {
                toast.classList.add('hidden');
            }, 4000);
        }

        /**
         * ============================================================================
         * INICIALIZAÇÃO SEGURA NO WINDOW.ONLOAD
         * ============================================================================
         */
        window.onload = function () {
            try {
                const audioEngine = new RomanticAudioEngine();
                const world3D = new VoxelLoveWorld3D('webgl-container');
                world3D.animateLoop();

                new LoveAdventureController(world3D, audioEngine);
            } catch (error) {
                console.error("Erro na inicialização da experiência:", error);
                showToast("Modo de compatibilidade ativado.");
            }
        };
    </script>
</body>
</html>
